<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/payment-paypal" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/payment-paypal" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="payments.paypal-checkout">
                <title>PayPal Checkout</title>
                <description>
                    Processes one-time PayPal order payments, including capture status reconciliation and full or partial refunds.
                </description>
            </capability>

            <capability id="payments.paypal-express-checkout">
                <title>PayPal Express Checkout</title>
                <description>
                    Adds configurable PayPal Express buttons to baskets and transfers approved payer and shipping data into the order flow.
                </description>
            </capability>

            <capability id="payments.paypal-subscriptions">
                <title>PayPal Subscriptions</title>
                <description>
                    Creates and manages recurring PayPal subscriptions, billing plans and legacy billing agreements with invoice and transaction reconciliation.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/payment-paypal/bin/images/Logo.png"/>

        <preview>
            <image src="URL_OPT_DIR/quiqqer/payment-paypal/bin/images/preview/Frontend_Basket.png"/>
            <image src="URL_OPT_DIR/quiqqer/payment-paypal/bin/images/preview/Frontend_SmallBasket.png"/>
            <image src="URL_OPT_DIR/quiqqer/payment-paypal/bin/images/preview/Frontend_Button.png"/>
            <image src="URL_OPT_DIR/quiqqer/payment-paypal/bin/images/preview/Backend_Settings.png"/>
        </preview>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/payment-paypal]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/payment-paypal/-/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/payment-paypal/-/wikis/home]]></wiki>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[PCSG QL-1.0]]></license>
            <license><![CDATA[GPL-3.0-or-later]]></license>
        </copyright>

        <languages>
            <language>de</language>
            <language>en</language>
        </languages>

        <provider>
            <payment src="\QUI\ERP\Payments\PayPal\Provider"/>
        </provider>

    </package>
</quiqqer>
