includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    phpVersion:
        min: 80200
        max: 80509
    paths:
        - src
        - ajax
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    stubFiles:
        - tests/phpstan-stubs/QUI/ERP/Order/Utils/Utils.stub
    treatPhpDocTypesAsCertain: false
    tipsOfTheDay: false
